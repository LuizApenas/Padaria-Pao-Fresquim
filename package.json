{
  "name": "padaria-pao-fresquim",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo do sistema de gestao da Padaria Pao Fresquim.",
  "scripts": {
    "dev:web": "npm run dev --workspace @padaria/web",
    "build:web": "npm run build --workspace @padaria/web",
    "preview:web": "npm run preview --workspace @padaria/web",
    "dev:api": "npm run dev --workspace @padaria/api",
    "start:api": "npm run start --workspace @padaria/api",
    "prisma:generate": "npm run prisma:generate --workspace @padaria/api",
    "prisma:validate": "npm run prisma:validate --workspace @padaria/api",
    "prisma:db:push": "npm run prisma:db:push --workspace @padaria/api",
    "prisma:studio": "npm run prisma:studio --workspace @padaria/api",
    "prisma:seed": "npm run prisma:seed --workspace @padaria/api",
    "storage:setup": "npm run storage:setup --workspace @padaria/api",
    "auth:seed": "npm run auth:seed --workspace @padaria/api"
  },
  "workspaces": [
    "apps/*"
  ]
}
